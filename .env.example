# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
ENV=development
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/road_health

# --- JWT ---
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Uploads ---
UPLOAD_DIR=app/uploads/reports
MAX_UPLOAD_SIZE_MB=10

# --- AI ---
# Leave blank to use the safe development stub instead of a real model.
AI_MODEL_PATH=

# --- Scheduler / Escalation ---
SCHEDULER_ENABLED=true
ESCALATION_INTERVAL_MINUTES=5

# --- SLA hours by priority (placeholders — confirm real values before production) ---
SLA_HOURS_CRITICAL=24
SLA_HOURS_HIGH=72
SLA_HOURS_MEDIUM=168
SLA_HOURS_LOW=336

# --- CORS ---
CORS_ORIGINS=["*"]
