# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
ENV=development
DEBUG=true

# --- Database ---
# Local PostgreSQL installation for this project uses port 5433.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/road_health

# --- JWT ---
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Uploads ---
UPLOAD_DIR=app/uploads/reports
MAX_UPLOAD_SIZE_MB=10

# --- AI / Roboflow ---
# Obtain your API key from https://app.roboflow.com/ (account -> API keys).
# Never commit the real key to Git.
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_MODEL_ID=rdd-india/9
ROBOFLOW_API_URL=https://detect.roboflow.com

# --- Scheduler / Escalation ---
SCHEDULER_ENABLED=true
ESCALATION_INTERVAL_MINUTES=5

# --- SLA hours by priority ---
SLA_HOURS_CRITICAL=24
SLA_HOURS_HIGH=72
SLA_HOURS_MEDIUM=168
SLA_HOURS_LOW=336

# --- CORS ---
CORS_ORIGINS=["*"]
